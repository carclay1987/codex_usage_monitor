{
  "name": "codex-usage-dashboard",
  "version": "0.1.0",
  "description": "Локальный монитор расхода токенов и контекста Codex",
  "author": "Ilya Inkuroshev",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "data": "node scripts/codex-data-server.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "desktop:renderer": "vite build --config vite.desktop.config.ts",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:pack": "npm run desktop:renderer && electron-builder --mac dir",
    "desktop:dmg": "npm run desktop:renderer && electron-builder --mac dmg",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components/usage-dashboard.tsx scripts desktop vite.desktop.config.ts",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.codexusagemonitor.desktop",
    "productName": "Codex Usage Monitor",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.mjs",
      "desktop-dist/**/*",
      "scripts/codex-data-server.mjs",
      "skills/codex-usage-audit/SKILL.md",
      "build/icon.iconset/icon_16x16.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.svg.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Codex Usage Monitor"
    }
  }
}
